{
  "entities": {
    "Organization": {
      "title": "Organization",
      "description": "Multi-tenant business organization entity (store, restaurant, cafe, enterprise)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique organization ID"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Organization trade name"
        },
        "taxNumber": {
          "type": "string",
          "maxLength": 40,
          "description": "VAT/Tax registration number (الرقم الضريبي)"
        },
        "commercialRegistration": {
          "type": "string",
          "maxLength": 50,
          "description": "Commercial registration number"
        },
        "activityType": {
          "type": "string",
          "enum": ["retail", "restaurant", "supermarket", "services", "other"],
          "description": "Type of commercial business"
        },
        "currency": {
          "type": "string",
          "enum": ["SAR", "AED", "QAR", "KWD", "USD"],
          "description": "Base accounting currency"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owning manager"
        },
        "ownerEmail": {
          "type": "string",
          "description": "Email of the owning manager"
        },
        "ownerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the manager"
        },
        "driveFolderId": {
          "type": "string",
          "description": "Google Drive folder ID for storing attachments"
        },
        "driveConnected": {
          "type": "boolean",
          "description": "Whether manager has linked their Google Drive account"
        },
        "isActive": {
          "type": "boolean",
          "description": "Optional organization active status"
        },
        "subscriptionPlan": {
          "type": "string",
          "enum": ["trial_7d", "1m", "3m", "6m", "1y"],
          "description": "Assigned subscription duration plan"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "expired", "suspended"],
          "description": "Subscription lifecycle status"
        },
        "subscriptionStartAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore Timestamp for subscription start"
        },
        "subscriptionEndAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore Timestamp for subscription end"
        },
        "subscriptionUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore Timestamp when subscription was last updated"
        },
        "subscriptionUpdatedBy": {
          "type": "string",
          "maxLength": 150,
          "description": "Super Admin identifier who last updated the subscription"
        },
        "subscriptionNote": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional administrative note on the subscription"
        },
        "branchPricingModel": {
          "type": "string",
          "enum": ["per_branch_50_sar", "per_extra_branch_50_sar"],
          "description": "Branch pricing model identifier (50 SAR/month starting from 1st branch on paid plans)"
        },
        "includedBranchesCount": {
          "type": "number",
          "description": "Number of included branches (0 for new paid orgs)"
        },
        "extraBranchMonthlyFeeSar": {
          "type": "number",
          "description": "Monthly SAR fee per billable branch (50 SAR)"
        },
        "extraBranchesCount": {
          "type": "number",
          "description": "Calculated billable branches count"
        },
        "extraBranchesMonthlyTotalSar": {
          "type": "number",
          "description": "Estimated monthly total fee in SAR for active billable branches"
        },
        "accountSetupFeeSar": {
          "type": "number",
          "description": "One-time new manager account/organization setup fee in SAR (80 SAR)"
        },
        "setupFeeStatus": {
          "type": "string",
          "enum": ["paid", "unpaid", "waived"],
          "description": "Manual tracking status of the 80 SAR account setup fee"
        },
        "setupFeePaidAt": {
          "type": "string",
          "format": "date-time",
          "description": "Recorded date when the 80 SAR setup fee was paid"
        },
        "reactivationFeeSar": {
          "type": "number",
          "description": "Organization reactivation fee in SAR after deactivation (10 SAR)"
        },
        "reactivationFeeStatus": {
          "type": "string",
          "enum": ["paid", "unpaid", "waived"],
          "description": "Manual tracking status of the 10 SAR reactivation fee"
        },
        "billingExempt": {
          "type": "boolean",
          "description": "Whether this organization has an official Super-Admin-granted permanent billing exemption"
        },
        "billingExemptScope": {
          "type": "string",
          "enum": ["full_permanent"],
          "description": "Scope of permanent billing exemption (all org fees, current branches, and future branches)"
        },
        "billingExemptReason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500,
          "description": "Mandatory administrative reason for granting permanent billing exemption"
        },
        "billingExemptGrantedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore Timestamp when permanent billing exemption was granted"
        },
        "billingExemptGrantedBy": {
          "type": "string",
          "maxLength": 150,
          "description": "Verified Super Admin email who granted the permanent billing exemption"
        },
        "billingExemptVerifiedOwnerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Verified org.ownerId bound to the permanent billing exemption (fails closed if owner changes)"
        },
        "billingExemptVerifiedOwnerEmail": {
          "type": "string",
          "maxLength": 254,
          "description": "Verified normalized lowercase org.ownerEmail bound to the permanent billing exemption"
        },
        "billingExemptRevokedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore Timestamp when permanent billing exemption was revoked (if revoked)"
        },
        "billingExemptRevokedBy": {
          "type": "string",
          "maxLength": 150,
          "description": "Verified Super Admin email who revoked the permanent billing exemption"
        },
        "billingExemptRevokeReason": {
          "type": "string",
          "maxLength": 500,
          "description": "Administrative reason for revoking permanent billing exemption"
        },
        "billingExemptLastAuditLogId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the atomically linked platformAuditLogs document for the last grant/revoke transition"
        },
        "reactivationFeePaidAt": {
          "type": "string",
          "format": "date-time",
          "description": "Recorded date when the 10 SAR reactivation fee was paid"
        },
        "reactivatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the deactivated organization was reactivated by Super Admin"
        },
        "reactivatedBy": {
          "type": "string",
          "description": "Super Admin email or UID who reactivated the organization"
        },
        "deactivationReason": {
          "type": "string",
          "enum": ["no_paid_branches", "manual_suspension", "expired"],
          "description": "Reason why the organization was deactivated"
        },
        "noPaidBranchGraceStartedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Start of the 7-day grace window when organization has zero paid branches"
        },
        "deactivationDueAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when organization auto-blocks after 7-day no-paid-branch grace"
        },
        "deactivatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when organization was deactivated"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "name", "activityType", "currency", "ownerEmail", "createdAt"]
    },
    "ManagerInvite": {
      "title": "ManagerInvite",
      "description": "Verified Google email invitation issued exclusively by Super Admin to bind an organization manager",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Normalized lowercase Google email matching document ID"
        },
        "email": {
          "type": "string",
          "maxLength": 254,
          "description": "Invited manager Google email"
        },
        "emailNormalized": {
          "type": "string",
          "maxLength": 254,
          "description": "Lowercase trimmed email matching document ID"
        },
        "orgId": {
          "type": "string",
          "description": "Target organization ID"
        },
        "orgName": {
          "type": "string",
          "maxLength": 120,
          "description": "Target organization display name"
        },
        "managerName": {
          "type": "string",
          "maxLength": 100,
          "description": "Optional manager display name"
        },
        "role": {
          "type": "string",
          "enum": ["manager"],
          "description": "Assigned role"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "cancelled"],
          "description": "Invitation status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Invitation creation timestamp"
        },
        "createdBy": {
          "type": "string",
          "maxLength": 150,
          "description": "Super Admin creator identifier"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when invite was claimed"
        },
        "acceptedByUid": {
          "type": "string",
          "description": "Firebase Auth UID of the manager who claimed the invite"
        },
        "cancelledAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when invite was cancelled"
        }
      },
      "required": ["id", "email", "emailNormalized", "orgId", "role", "status", "createdAt", "createdBy", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile holding tenant affiliation, role, branch, and permissions",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth user UID"
        },
        "orgId": {
          "type": "string",
          "description": "Affiliated organization ID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User display name"
        },
        "role": {
          "type": "string",
          "enum": ["manager", "supervisor", "branch_manager", "employee"],
          "description": "Role within the organization"
        },
        "branchId": {
          "type": "string",
          "description": "Assigned branch ID for employee or branch manager"
        },
        "branchIds": {
          "type": "array",
          "description": "Optional assigned branch IDs list (single branch enforced for branch_manager)"
        },
        "branchName": {
          "type": "string",
          "description": "Assigned branch name"
        },
        "phone": {
          "type": "string",
          "maxLength": 25,
          "description": "Phone number"
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether account is currently active"
        },
        "isArchived": {
          "type": "boolean",
          "description": "Soft-archive flag retaining all historical financial and audit records"
        },
        "archivedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when employee account was archived"
        },
        "archivedBy": {
          "type": "string",
          "description": "Manager UID who archived the employee account"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["uid", "orgId", "email", "displayName", "role", "isActive", "createdAt"]
    },
    "Branch": {
      "title": "Branch",
      "description": "Commercial branch belonging to an organization",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Branch unique ID"
        },
        "orgId": {
          "type": "string",
          "description": "Parent organization ID"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Branch display name"
        },
        "code": {
          "type": "string",
          "maxLength": 20,
          "description": "Branch code/identifier"
        },
        "address": {
          "type": "string",
          "maxLength": 255,
          "description": "Physical address"
        },
        "phone": {
          "type": "string",
          "maxLength": 25,
          "description": "Contact telephone"
        },
        "isActive": {
          "type": "boolean",
          "description": "Branch active status"
        },
        "lifecycleStatus": {
          "type": "string",
          "enum": ["active", "suspended", "purged_from_db"],
          "description": "Branch lifecycle status controlled exclusively by Super Admin"
        },
        "subscriptionStartAt": {
          "type": "string",
          "format": "date-time",
          "description": "Branch billing start date"
        },
        "feeDueAt": {
          "type": "string",
          "format": "date-time",
          "description": "Branch next monthly fee due date"
        },
        "monthlyFeeSar": {
          "type": "number",
          "description": "Monthly branch fee in SAR (50 SAR)"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "unpaid", "overdue", "exempt"],
          "description": "Manual branch payment tracking status"
        },
        "lastPaidAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date of last recorded 50 SAR branch payment"
        },
        "suspendedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when branch was suspended (starts 30-day grace)"
        },
        "gracePeriodEndsAt": {
          "type": "string",
          "format": "date-time",
          "description": "End of 30-day post-suspension grace window before DB purge eligibility"
        },
        "driveBackupVerified": {
          "type": "boolean",
          "description": "Whether complete Google Drive backup proof was verified prior to DB purge"
        },
        "driveBackupVerifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when Google Drive backup completeness was verified"
        },
        "purgedFromDbAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when branch records were purged from Firestore DB"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Branch creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Branch last update timestamp"
        }
      },
      "required": ["id", "orgId", "name", "code", "isActive", "createdAt"]
    },
    "ShiftClosing": {
      "title": "ShiftClosing",
      "description": "Daily shift closing financial record with cash, card, and expense reconciliations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Shift closing unique ID"
        },
        "orgId": {
          "type": "string",
          "description": "Tenant organization ID"
        },
        "branchId": {
          "type": "string",
          "description": "Branch ID"
        },
        "branchName": {
          "type": "string",
          "description": "Branch name snapshot"
        },
        "employeeId": {
          "type": "string",
          "description": "UID of employee submitting closing"
        },
        "employeeName": {
          "type": "string",
          "description": "Name of employee"
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Shift calendar date YYYY-MM-DD"
        },
        "period": {
          "type": "string",
          "enum": ["morning", "evening"],
          "description": "Shift timing period"
        },
        "cashSales": {
          "type": "number",
          "description": "Actual physical cash received"
        },
        "cardSales": {
          "type": "number",
          "description": "Electronic card POS network sales"
        },
        "totalSales": {
          "type": "number",
          "description": "Gross sales: cashSales + cardSales"
        },
        "expenses": {
          "type": "number",
          "description": "Petty cash purchases & expenses"
        },
        "remainingInBox": {
          "type": "number",
          "description": "Expected drawer cash: cashSales - expenses"
        },
        "netPeriod": {
          "type": "number",
          "description": "Net period revenue: totalSales - expenses"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Cashier or auditor remarks"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "pending_review", "approved", "rejected"],
          "description": "Closing workflow approval status"
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 500,
          "description": "Explanation provided by manager if rejected"
        },
        "attachmentIds": {
          "type": "array",
          "description": "List of associated receipt attachment IDs"
        },
        "reviewedBy": {
          "type": "string",
          "description": "UID of manager who reviewed"
        },
        "reviewedByName": {
          "type": "string",
          "description": "Name of reviewing manager"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Review timestamp"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "orgId", "branchId", "employeeId", "date", "period", "cashSales", "cardSales", "totalSales", "expenses", "remainingInBox", "netPeriod", "status", "createdAt"]
    },
    "Attachment": {
      "title": "Attachment",
      "description": "Invoice or POS receipt metadata uploaded for a shift closing or purchase",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Attachment ID"
        },
        "orgId": {
          "type": "string",
          "description": "Organization ID"
        },
        "branchId": {
          "type": "string",
          "description": "Branch ID"
        },
        "closingId": {
          "type": "string",
          "description": "Associated shift closing ID"
        },
        "purchaseId": {
          "type": "string",
          "description": "Existing associated purchase invoice ID verified via existsAfter/getAfter (when attachment belongs to a purchase)"
        },
        "fileName": {
          "type": "string",
          "maxLength": 255,
          "description": "Original file name"
        },
        "fileSize": {
          "type": "number",
          "description": "Size in bytes"
        },
        "mimeType": {
          "type": "string",
          "maxLength": 100,
          "description": "MIME content type"
        },
        "fileUrl": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^(|https://(drive\\.google\\.com|docs\\.google\\.com|firebasestorage\\.googleapis\\.com|storage\\.googleapis\\.com)/.*)$",
          "description": "Empty or HTTPS URL on allowlisted Drive/Docs/Storage domains (blocks javascript:, http:, data:, untrusted domains)"
        },
        "driveFileId": {
          "type": "string",
          "maxLength": 256,
          "description": "Google Drive file ID"
        },
        "driveWebViewLink": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(|https://(drive\\.google\\.com|docs\\.google\\.com|firebasestorage\\.googleapis\\.com|storage\\.googleapis\\.com)/.*)$",
          "description": "Empty or HTTPS Google Drive/Docs/Storage view link"
        },
        "uploadedBy": {
          "type": "string",
          "description": "Uploader UID"
        },
        "uploadedByName": {
          "type": "string",
          "maxLength": 120,
          "description": "Uploader name"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        }
      },
      "required": ["id", "orgId", "fileName", "uploadedBy", "uploadedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational log entry for compliance",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Log entry unique ID"
        },
        "orgId": {
          "type": "string",
          "description": "Organization ID"
        },
        "actorId": {
          "type": "string",
          "description": "UID of user who performed action"
        },
        "actorName": {
          "type": "string",
          "description": "Name of actor"
        },
        "actorRole": {
          "type": "string",
          "enum": ["manager", "supervisor", "branch_manager", "employee"],
          "description": "Role of actor"
        },
        "action": {
          "type": "string",
          "description": "Action executed"
        },
        "targetType": {
          "type": "string",
          "enum": ["closing", "branch", "employee", "drive", "organization", "supplier", "purchase"],
          "description": "Type of affected resource"
        },
        "targetId": {
          "type": "string",
          "description": "ID of target resource"
        },
        "details": {
          "type": "string",
          "maxLength": 1000,
          "description": "Descriptive details"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Action timestamp"
        }
      },
      "required": ["id", "orgId", "actorId", "actorName", "actorRole", "action", "targetType", "targetId", "timestamp"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Registered supplier entity belonging to an organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "contactPerson": { "type": "string", "maxLength": 120, "description": "Primary supplier contact person" },
        "companyName": { "type": "string", "maxLength": 150, "description": "Registered supplier company name" },
        "taxNumber": { "type": "string", "maxLength": 40 },
        "phone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "maxLength": 254 },
        "address": { "type": "string", "maxLength": 255 },
        "notes": { "type": "string", "maxLength": 1000 },
        "openingBalance": { "type": "number", "description": "Opening financial balance for supplier" },
        "isActive": { "type": "boolean" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "name", "isActive", "createdBy", "createdAt", "updatedAt"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Branch-scoped purchase invoice tied to a registered active organization supplier",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string", "maxLength": 120 },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string", "maxLength": 120 },
        "taxNumber": { "type": "string", "maxLength": 40, "description": "Supplier VAT/tax registration number" },
        "invoiceNumber": { "type": "string", "maxLength": 80, "description": "Vendor purchase invoice reference number" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "items": {
          "type": "array",
          "maxItems": 1,
          "description": "Optional inline line items array (proven safe maxItems: 1 under Firestore 1,000-expression cap; each item validates exact 5 keys id/name/quantity/unitPrice/total, roundHalalas(qty*unitPrice)==total, sum(total)==amount; multi-item invoices should use subcollection purchases/{purchaseId}/items/{itemId})"
        },
        "amount": { "type": "number", "description": "Pre-discount subtotal in base currency (must strictly equal subtotalAmount when subtotalAmount is present)" },
        "subtotalAmount": { "type": "number", "description": "Pre-discount subtotal in base currency (must strictly equal amount)" },
        "discountAmount": { "type": "number", "description": "Non-negative discount amount <= subtotalAmount (2-decimal Halala precision)" },
        "vatRate": { "type": "number", "description": "Applied VAT percentage in [0, 100] with max 2 decimal places (0.01%)" },
        "vatAmount": { "type": "number", "description": "Exact pure-integer Halala VAT matching floor((taxableH * round(vatRate*100) + 5000)/10000) with zero Halala tolerance" },
        "totalAmount": { "type": "number", "description": "Final invoice total: amount - discountAmount + vatAmount" },
        "paymentMethod": { "type": "string", "enum": ["cash", "card", "transfer", "credit"] },
        "notes": { "type": "string", "maxLength": 1000 },
        "attachmentIds": {
          "type": "array",
          "maxItems": 1,
          "description": "Optional list of associated purchase attachment IDs (maxItems: 1), each verified via getAfter against orgId, branchId, and purchaseId"
        },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string", "maxLength": 120 },
        "createdByRole": { "type": "string", "enum": ["manager", "supervisor", "branch_manager", "employee"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "branchId", "supplierId", "date", "amount", "totalAmount", "paymentMethod", "createdBy", "createdByRole", "createdAt", "updatedAt"]
    },
    "PurchaseSubLineItem": {
      "title": "PurchaseSubLineItem",
      "description": "Ordered line item stored in /purchases/{purchaseId}/items/{itemId} subcollection (supports up to 100 items: item_0 .. item_99)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^item_([0-9]|[1-9][0-9])$", "description": "Deterministic item document ID matching item_{lineIndex}" },
        "purchaseId": { "type": "string", "description": "Parent purchase document ID" },
        "orgId": { "type": "string", "description": "Organization ID matching parent purchase" },
        "branchId": { "type": "string", "description": "Branch ID matching parent purchase" },
        "lineIndex": { "type": "integer", "description": "Zero-based item index in [0, 99]" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Item description/name" },
        "quantity": { "type": "number", "description": "Positive quantity > 0" },
        "unitPrice": { "type": "number", "description": "Non-negative unit price with max 2 decimal places" },
        "total": { "type": "number", "description": "Line total matching roundHalalas(quantity * unitPrice)" },
        "createdBy": { "type": "string", "description": "Creator UID matching auth.uid and parent purchase createdBy" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "purchaseId", "orgId", "branchId", "lineIndex", "name", "quantity", "unitPrice", "total", "createdBy", "createdAt"]
    },
    "ClosingArchive": {
      "title": "ClosingArchive",
      "description": "Google Drive Excel archive status, revision proof, and SHA-256 verification index for a shift closing",
      "type": "object",
      "properties": {
        "closingId": {
          "type": "string",
          "description": "Associated shift closing document ID"
        },
        "orgId": {
          "type": "string",
          "description": "Organization ID"
        },
        "branchId": {
          "type": "string",
          "description": "Branch ID"
        },
        "yearMonth": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "description": "Calendar month YYYY-MM matching closing date"
        },
        "archiveStatus": {
          "type": "string",
          "enum": ["pending_drive_sync", "archived", "failed", "stale"],
          "description": "Current Drive Excel archival lifecycle status"
        },
        "driveExcelFileId": {
          "type": "string",
          "maxLength": 256,
          "description": "Verified Google Drive file ID of the archived Excel workbook"
        },
        "driveExcelFileName": {
          "type": "string",
          "maxLength": 256,
          "description": "Verified .xlsx file name in Google Drive"
        },
        "driveExcelWebViewLink": {
          "type": "string",
          "maxLength": 512,
          "description": "Direct Google Drive webViewLink to the archived Excel file"
        },
        "driveMonthFolderId": {
          "type": "string",
          "maxLength": 256,
          "description": "Parent YYYY-MM folder ID in Google Drive"
        },
        "drivePayloadHash": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 hex digest of canonical closing financial payload"
        },
        "driveRevision": {
          "type": "number",
          "description": "Positive integer Excel archive revision (1, 2, 3...)"
        },
        "previousDriveExcelFileId": {
          "type": "string",
          "maxLength": 256,
          "description": "Prior Drive file ID superseded after administrative correction"
        },
        "sourceCorrectionAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of parent closing correctedAt associated with this revision"
        },
        "archivedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when Drive Excel upload and read-back verification succeeded"
        },
        "archivedBy": {
          "type": "string",
          "description": "UID of verified organization manager/owner who executed archival"
        },
        "archiveError": {
          "type": "string",
          "maxLength": 1000,
          "description": "Error summary when Drive archival fails"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last archive record update timestamp"
        }
      },
      "required": ["closingId", "orgId", "branchId", "yearMonth", "archiveStatus", "updatedAt"]
    },
    "PlatformAuditLog": {
      "title": "PlatformAuditLog",
      "description": "Immutable Super Admin platform-level audit trail for organizations, invites, billing, and branch lifecycle actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorEmail": { "type": "string", "maxLength": 254 },
        "actorUid": { "type": "string" },
        "action": { "type": "string", "maxLength": 80 },
        "targetType": { "type": "string", "enum": ["organization", "branch", "invite", "billing"] },
        "targetId": { "type": "string" },
        "orgId": { "type": "string" },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorEmail", "actorUid", "action", "targetType", "targetId", "details", "timestamp"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "Role-scoped, tenant-isolated real-time notification document with deterministic dedupKey ID and per-user readBy map",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dedupKey": { "type": "string", "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["employees", "closings", "schedule_requests", "purchases_suppliers", "org_branches", "security_admin"]
        },
        "type": { "type": "string", "maxLength": 80 },
        "severity": { "type": "string", "enum": ["info", "success", "warning", "critical"] },
        "audienceScope": {
          "type": "string",
          "enum": ["user", "org_manager", "org_supervisor_permission", "branch_manager", "super_admin"]
        },
        "orgId": { "type": "string" },
        "relatedOrgId": { "type": "string" },
        "branchId": { "type": "string" },
        "branchName": { "type": "string", "maxLength": 120 },
        "recipientUid": { "type": "string" },
        "requiredPermission": { "type": "string", "maxLength": 64 },
        "secondaryPermission": { "type": "string", "maxLength": 64 },
        "feedKeys": { "type": "array" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 40 },
        "title": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 1000 },
        "targetType": {
          "type": "string",
          "enum": ["employee", "closing", "schedule_request", "purchase", "supplier", "branch", "organization", "drive", "security"]
        },
        "targetId": { "type": "string" },
        "navTarget": { "type": "object" },
        "readBy": { "type": "object" },
        "isRead": { "type": "boolean" },
        "readAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "dedupKey",
        "category",
        "type",
        "severity",
        "audienceScope",
        "orgId",
        "feedKeys",
        "actorUid",
        "actorName",
        "actorRole",
        "title",
        "body",
        "readBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/organizations/{orgId}": {
      "schema": "Organization",
      "description": "Organization documents keyed by orgId"
    },
    "/managerInvites/{inviteEmail}": {
      "schema": "ManagerInvite",
      "description": "Super Admin issued manager email invitations keyed by normalized email"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles keyed by auth UID"
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Store branches belonging to an organization"
    },
    "/closings/{closingId}": {
      "schema": "ShiftClosing",
      "description": "Daily shift closings"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Organization suppliers"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "Branch-scoped purchases"
    },
    "/purchases/{purchaseId}/items/{itemId}": {
      "schema": "PurchaseSubLineItem",
      "description": "Ordered purchase invoice line items subcollection (item_0 .. item_99, up to 100 items)"
    },
    "/attachments/{attachmentId}": {
      "schema": "Attachment",
      "description": "Receipt and invoice attachment metadata"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable administrative audit log events"
    },
    "/closingArchives/{closingId}": {
      "schema": "ClosingArchive",
      "description": "Google Drive Excel archival index keyed by closingId"
    },
    "/platformAuditLogs/{logId}": {
      "schema": "PlatformAuditLog",
      "description": "Immutable Super Admin platform audit trail"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "Role-scoped real-time notifications with deterministic deduplicated IDs and per-user read tracking"
    }
  }
}
